@startuml
' Настройки стиля
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Consolas

' ======================
' Интерфейсы
' ======================
interface ICard {
  + getSuit(): Suit
  + getRank(): Rank
  + isFaceUp(): boolean
  + flip(): void
}

interface IPile {
  + addCard(card: ICard): boolean
  + removeCard(): ICard
  + peekTop(): ICard
  + isEmpty(): boolean
  + size(): int
  + canAddCard(card: ICard): boolean
}

interface IGameRules {
  + isValidMove(from: IPile, to: IPile, card: ICard): boolean
  + isGameWon(board: GameBoard): boolean
}

' ======================
' Перечисления (Enums)
' ======================
class Suit <<enumeration>> {
  HEARTS
  DIAMONDS
  CLUBS
  SPADES
}

class Rank <<enumeration>> {
  ACE = 1
  TWO = 2
  THREE = 3
  FOUR = 4
  FIVE = 5
  SIX = 6
  SEVEN = 7
  EIGHT = 8
  NINE = 9
  TEN = 10
  JACK = 11
  QUEEN = 12
  KING = 13
}

' ======================
' Классы
' ======================
class Card {
  - suit: Suit
  - rank: Rank
  - faceUp: boolean
  + Card(suit: Suit, rank: Rank)
  + getSuit(): Suit
  + getRank(): Rank
  + isFaceUp(): boolean
  + flip(): void
  + toString(): String
}

abstract class Pile {
  - cards: List<ICard>
  + Pile()
  + addCard(card: ICard): boolean
  + removeCard(): ICard
  + peekTop(): ICard
  + isEmpty(): boolean
  + size(): int
  {abstract} + canAddCard(card: ICard): boolean
}

class TableauPile {
  + TableauPile()
  + revealTopCard(): void
  {override} + canAddCard(card: ICard): boolean
}

class FoundationPile {
  - suit: Suit
  + FoundationPile(suit: Suit)
  {override} + canAddCard(card: ICard): boolean
}

class StockPile {
  + StockPile(cards: List<ICard>)
  + drawCard(): ICard
  {override} + canAddCard(card: ICard): boolean
}

class WastePile {
  + WastePile()
  + peekTopFaceUp(): ICard
  {override} + canAddCard(card: ICard): boolean
}

class Deck {
  - cards: List<ICard>
  + Deck()
  + shuffle(): void
  + deal(n: int): List<ICard>
  + isEmpty(): boolean
  + size(): int
}

class GameBoard {
  - tableau: List<TableauPile>
  - foundations: List<FoundationPile>
  - stock: StockPile
  - waste: WastePile
  + GameBoard()
  + initialize(deck: Deck): void
  + moveCard(from: IPile, to: IPile): boolean
  + isGameWon(): boolean
}

class KlondikeRules {
  + KlondikeRules()
  + isValidMove(from: IPile, to: IPile, card: ICard): boolean
  + isGameWon(board: GameBoard): boolean
}

class SolitaireGame {
  - board: GameBoard
  - rules: IGameRules
  - deck: Deck
  + SolitaireGame(rules: IGameRules)
  + startNewGame(): void
  + makeMove(fromPile: IPile, toPile: IPile): boolean
  + isWon(): boolean
  + getBoard(): GameBoard
}

' ======================
' Отношения
' ======================

' Реализация интерфейсов
ICard <|.. Card
IPile <|.. Pile
IGameRules <|.. KlondikeRules

' Наследование
Pile <|-- TableauPile
Pile <|-- FoundationPile
Pile <|-- StockPile
Pile <|-- WastePile

' Композиции (жёсткое владение)
GameBoard *-- "7" TableauPile : contains\n(composition)
GameBoard *-- "4" FoundationPile : contains\n(composition)
GameBoard *-- "1" StockPile : contains\n(composition)
GameBoard *-- "1" WastePile : contains\n(composition)

Pile *-- "0..*" ICard : owns cards\n(composition)
Deck *-- "52" ICard : creates\n(composition)

' Агрегации (использование без владения)
SolitaireGame o-- GameBoard : uses\n(aggregation)
SolitaireGame o-- IGameRules : applies\n(aggregation)
SolitaireGame o-- Deck : manages\n(aggregation)

' Зависимости
GameBoard ..> IGameRules : delegates validation
TableauPile ..> Suit : uses
TableauPile ..> Rank : uses
FoundationPile ..> Suit : uses

' Примечания для ясности
note right of GameBoard
  Инициализирует игру:
  - раздаёт карты в tableau
  - создаёт stock и foundation
end note

note top of SolitaireGame
  Главный контроллер игры.
  Делегирует логику правил.
end note
@enduml