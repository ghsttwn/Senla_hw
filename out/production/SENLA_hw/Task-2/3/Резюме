@startuml
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor #666666
    FontSize 13
}

class Applicant {
    + int id
    + string firstName
    + string lastName
    + Date dateOfBirth
    + string email
    + string phone
    --
    + getFullName(): string
    + isEligibleForJob(string jobType): bool
}

class Resume {
    + string resumeId
    + string title
    + string summary
    + Date lastUpdated
    + bool isPublic
    --
    + addExperience(WorkExperience exp): void
    + addEducation(Education edu): void
    + generatePDF(): byte[]
    + publish(): void
    + unpublish(): void
}

class WorkExperience {
    + string companyName
    + string position
    + Date startDate
    + Date endDate
    + string description
    --
    + isCurrent(): bool
    + getDurationMonths(): int
}

class Education {
    + string institution
    + string degree
    + string fieldOfStudy
    + Date graduationDate
    + float gpa
    --
    + isCompleted(): bool
}

Resume "1" *-- "1" Applicant : belongs to >
Resume "1" *-- "0..*" WorkExperience : includes >
Resume "1" *-- "0..*" Education : includes >
@enduml